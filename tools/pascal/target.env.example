# Copy to target.env (not committed) and fill in. Read by tools/pascal/remote.sh.
PASCAL_JUMP=user@jump-host          # first hop
PASCAL_JUMP_PORT=22
PASCAL_HOST=user@gpu-host           # the machine with the GTX 1080, reached from the jump host
PASCAL_HOST_PORT=22
PASCAL_CONTAINER=lfm3-pascal        # LXD container with the GPU device
PASCAL_HOST_WORKSPACE=/mnt/engine/lfm3-pascal   # host directory mounted in the container at /workspace
