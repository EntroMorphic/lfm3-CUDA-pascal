# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,log}]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Vendored code keeps its own style
[native/third_party/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Records are kept as produced
[validation/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
